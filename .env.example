# KolektaPH: where the app keeps its data.
#
# Copy this file to .env.local (which git ignores) to run the app on the pilot database:
#
#   cp .env.example .env.local
#
# Without these two values the app runs on the sample (mock) services: no server, everything on
# the device. Both values are public by design: the publishable key only lets a device do what
# the database's own rules allow (see supabase/README.md). Never put a secret key here; the app
# refuses one.
EXPO_PUBLIC_SUPABASE_URL=https://mxitciwrvcxitwkfszbd.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_3rTg4A3PtYIHjG824HYQgQ_xb00Ntz8
